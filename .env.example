# Copy to .env.local for development, or set these in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://beyondchiavari.com

# Password for /admin (any username). Required in production.
ADMIN_PASSWORD=

# Supabase: where votes and leads are stored in production. Run supabase/schema.sql first.
# Leave blank in development to use a local file (.data/db.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email yourself every new lead (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM="Beyond Chiavari <hello@beyondchiavari.com>"

# CRM: every lead (quote, quiz, waitlist) is also sent here. See docs/crm-setup.md.
# HubSpot private app token. Run `npm run crm:setup` once after setting it.
HUBSPOT_ACCESS_TOKEN=
# Optional: where quote requests land as deals (setup script prints the IDs). Defaults to the standard pipeline's first stage.
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=
# Optional: also post every lead as JSON to Zapier, Make, n8n, an email tool, a Google Sheet…
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# The free 15-minute consult booking page (HubSpot Meetings, Calendly or Cal.com). Booking buttons stay hidden until set.
NEXT_PUBLIC_BOOKING_URL=
