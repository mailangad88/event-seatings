# Copy to .env.local for development, or set these in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://beyondchiavari.com

# Password for /admin (any username). Required in production.
ADMIN_PASSWORD=

# Supabase: where votes and leads are stored in production. Run supabase/schema.sql first.
# Leave blank in development to use a local file (.data/db.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email yourself every new lead (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM="Beyond Chiavari <hello@beyondchiavari.com>"

# CRM: every lead (quote, quiz, waitlist) is also sent here. See docs/crm-setup.md.
# HubSpot private app token. Run `npm run crm:setup` once after setting it.
HUBSPOT_ACCESS_TOKEN=
# Optional: where quote requests land as deals (setup script prints the IDs). Defaults to the standard pipeline's first stage.
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=
# Optional: also post every lead as JSON to Zapier, Make, n8n, an email tool, a Google Sheet…
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# The free 15-minute consult booking page (HubSpot Meetings, Calendly or Cal.com). Booking buttons stay hidden until set.
NEXT_PUBLIC_BOOKING_URL=

# Measurement (see docs/seo-data/setup-checklist.md). All optional; nothing loads until set.
# GA4 Measurement ID, e.g. G-ABC123XYZ
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification code (just the content="..." value)
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 code
NEXT_PUBLIC_BING_VERIFICATION=

# Chat dock and instant contact (all optional; each channel appears once set). See docs/live-chat-setup.md
# HubSpot account ID: turns on HubSpot live chat + chatbot inside the chat panel.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# Business line in +1XXXXXXXXXX form ("Call" button), and a textable number if different ("Text us").
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_SMS_PHONE=
# WhatsApp number, digits with country code, e.g. 16305550123
NEXT_PUBLIC_WHATSAPP=
# Optional: the reply promise under "How can we help?" Keep it true.
NEXT_PUBLIC_REPLY_PROMISE=

# Business hours someone actually covers, e.g. "Mon–Sat, 9am–6pm". With it set, the site promises a reply within one
# business hour in those hours; left blank, it only promises a reply within one business day. Keep it true.
NEXT_PUBLIC_BUSINESS_HOURS=

# Booking fee checkout (Stripe). Off until STRIPE_SECRET_KEY is set. Proposals (/proposal/<token>, created in
# /admin/leads) hide the rental company's name until the fee or hold is paid.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://beyondchiavari.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# "fee" (default: our 10% booking fee) or "hold" (a fixed refundable hold of BOOKING_HOLD_USD)
BOOKING_CHARGE=fee
BOOKING_HOLD_USD=100

# Error alerts: a Slack or Discord incoming webhook URL. Server and browser errors post here (throttled).
# Also add it as a GitHub repository secret ALERT_WEBHOOK_URL for uptime alerts.
ALERT_WEBHOOK_URL=
# A/B tests (GrowthBook, open source). Leave empty to switch experiments off.
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=
# Only for a self-hosted GrowthBook; defaults to GrowthBook Cloud's free CDN.
NEXT_PUBLIC_GROWTHBOOK_API_HOST=

# Planning assistant (/planning-assistant). "on" shows the page and its chat-dock shortcut.
NEXT_PUBLIC_PLANNING_ASSISTANT=
# "gemini" lets Gemini write plan summaries and answers (costs money; needs GEMINI_API_KEY).
ASSISTANT_AI=
# Optional: model (default gemini-flash-lite-latest) and daily caps per server instance.
ASSISTANT_GEMINI_MODEL=
ASSISTANT_AI_DAILY_CAP=300
ASSISTANT_AI_PER_VISITOR=12
